/-!
# `JoinResult` laws modulo the congruence `try_join` generates

`JoinResult.lean` compares results structurally (conflicts as sets of values) and finds that
the laws then force `try_join` to be flat. That equality is too fine when `try_join` merges
values semantically, e.g. MuSig2 partial signatures, or a list of tap leaf hashes that is
semantically a set: structurally different results can mean the same thing. So here a result
means what it denotes. A *model* is a bounded join-semilattice `S` with a map `f : V → S` that
`try_join` respects: `try_join a b = Ok c` gives `f c = f a ⊔ f b`, and a conflict it returns
denotes `f a ⊔ f b`. Two results are `Equiv` when every model gives them the same denotation:
the congruence generated by `try_join`'s equations, which also quotients out any equivalence
that `try_join` treats as equality (e.g. leaf lists with the same set of leaves).

Results:
* `denote_join`: `join` is a homomorphism into every model.
* `join_idem`, `join_comm`, `join_assoc`, `join_congr`: hence `join` is a semilattice modulo
  `Equiv`, for *any* `try_join`; no flatness needed.
* `self_join_equiv`: if `try_join a a = Ok n` then `Ok a` and `Ok n` are equivalent: a
  normalising join (e.g. sorting tap leaf hashes) is idempotent modulo `Equiv`.
* `option_converges`, `option_nontrivial`: the diverging states of the TLA+ counterexample,
  `Err{x, y}` and `Err{absent, x, y}`, are equivalent, yet `Equiv` does not identify everything.
* `flat_equiv_members`: for a flat `try_join`, equivalent results have the same members, so
  there `Equiv` is no coarser than the set equality `Conflict`'s `PartialEq` implements. For
  non-flat joins the Rust `==` is finer than `Equiv`: converged replicas can compare unequal.

This file stands alone and transcribes the same `partial.rs` as `JoinResult.lean`, but it
re-declares `JoinResult`, `join`, `Field` and `optionJoin` with `Conflict` as a `List`, as the
Rust `Vec` is, instead of the characteristic function used there. Order and duplicates don't
affect denotations, and a list lets the states of the TLA+ counterexample be written out
literally; it also keeps the two modules independent of each other.
-/

namespace ConcurrentPsbt.Modulo

/-- A bounded join-semilattice, stated directly since there is no Mathlib. -/
class Semilattice (S : Type) where
  sup : S → S → S
  bot : S
  sup_idem : ∀ a, sup a a = a
  sup_comm : ∀ a b, sup a b = sup b a
  sup_assoc : ∀ a b c, sup (sup a b) c = sup a (sup b c)
  bot_sup : ∀ a, sup bot a = a

open Semilattice

instance {S : Type} [Semilattice S] : Std.Associative (sup (S := S)) := ⟨sup_assoc⟩
instance {S : Type} [Semilattice S] : Std.Commutative (sup (S := S)) := ⟨sup_comm⟩

theorem sup_bot {S : Type} [Semilattice S] (a : S) : sup a bot = a := by
  rw [sup_comm, bot_sup]

theorem sup_absorb {S : Type} [Semilattice S] (a b : S) : sup a (sup a b) = sup a b := by
  rw [← sup_assoc, sup_idem]

inductive JoinResult (V : Type) where
  | ok (v : V)
  | err (c : List V)

open JoinResult

variable {V : Type} [DecidableEq V]

/-- `impl JoinMut for Conflict<V>`: append the entries of `b` that `a` lacks. -/
def union (a b : List V) : List V := a ++ b.filter (fun x => !a.contains x)

/-- `impl<V: PartialJoin> Join for JoinResult<V>`. -/
def join (tryJoin : V → V → JoinResult V) : JoinResult V → JoinResult V → JoinResult V
  | ok a, ok b => tryJoin a b
  | err a, err b => err (union a b)
  | err a, ok b => err (union a [b])
  | ok a, err b => err (union [a] b)

section Denote

variable {S : Type} [Semilattice S] (f : V → S)

def denoteList : List V → S
  | [] => bot
  | v :: l => sup (f v) (denoteList l)

def denote : JoinResult V → S
  | ok v => f v
  | err l => denoteList f l

omit [DecidableEq V] in
theorem denoteList_append (a b : List V) :
    denoteList f (a ++ b) = sup (denoteList f a) (denoteList f b) := by
  induction a with
  | nil => simp [denoteList, bot_sup]
  | cons v l ih => simp only [List.cons_append, denoteList, ih, sup_assoc]

omit [DecidableEq V] in
/-- A member's value is already below the conflict's denotation. -/
theorem absorb_mem {x : V} {a : List V} (h : x ∈ a) :
    sup (f x) (denoteList f a) = denoteList f a := by
  induction a with
  | nil => cases h
  | cons v l ih =>
    simp only [denoteList]
    cases h with
    | head => exact sup_absorb _ _
    | tail _ h =>
      calc sup (f x) (sup (f v) (denoteList f l))
          = sup (f v) (sup (f x) (denoteList f l)) := by ac_rfl
        _ = sup (f v) (denoteList f l) := by rw [ih h]

omit [DecidableEq V] in
theorem denote_filter (a b : List V) (p : V → Bool) (h : ∀ x ∈ b, p x = false → x ∈ a) :
    sup (denoteList f a) (denoteList f (b.filter p)) = sup (denoteList f a) (denoteList f b) := by
  induction b with
  | nil => rfl
  | cons x l ih =>
    have ih := ih (fun y hy hp => h y (by simp [hy]) hp)
    by_cases hp : p x = true
    · simp only [List.filter_cons, hp, ↓reduceIte, denoteList]
      calc sup (denoteList f a) (sup (f x) (denoteList f (l.filter p)))
          = sup (f x) (sup (denoteList f a) (denoteList f (l.filter p))) := by ac_rfl
        _ = sup (f x) (sup (denoteList f a) (denoteList f l)) := by rw [ih]
        _ = sup (denoteList f a) (sup (f x) (denoteList f l)) := by ac_rfl
    · have hx : x ∈ a := h x (by simp) (by simpa using hp)
      simp only [List.filter_cons, hp, denoteList]
      simp only [Bool.false_eq_true, ↓reduceIte]
      rw [ih]
      calc sup (denoteList f a) (denoteList f l)
          = sup (sup (f x) (denoteList f a)) (denoteList f l) := by rw [absorb_mem f hx]
        _ = sup (denoteList f a) (sup (f x) (denoteList f l)) := by ac_rfl

theorem denote_union (a b : List V) :
    denoteList f (union a b) = sup (denoteList f a) (denoteList f b) := by
  rw [union, denoteList_append]
  apply denote_filter
  intro x _ hx
  simpa using hx

end Denote

/-- `f` is a model of `tryJoin`: every equation `try_join` asserts holds in `S`. -/
structure Sound {S : Type} [Semilattice S] (tryJoin : V → V → JoinResult V) (f : V → S) :
    Prop where
  ok : ∀ {a b c}, tryJoin a b = .ok c → f c = sup (f a) (f b)
  err : ∀ {a b l}, tryJoin a b = .err l → denoteList f l = sup (f a) (f b)

theorem denote_join {S : Type} [Semilattice S] (f : V → S) {tryJoin : V → V → JoinResult V}
    (hf : Sound tryJoin f) (x y : JoinResult V) :
    denote f (join tryJoin x y) = sup (denote f x) (denote f y) := by
  cases x <;> cases y <;> simp only [join, denote]
  case ok.ok a b =>
    cases h : tryJoin a b with
    | ok c => exact hf.ok h
    | err l => exact hf.err h
  case err.err a b => exact denote_union f a b
  case err.ok a b => rw [denote_union]; simp [denoteList, sup_bot]
  case ok.err a b => rw [denote_union]; simp [denoteList, sup_bot]

/-- Equal in every model: the congruence generated by `tryJoin`. -/
def Equiv (tryJoin : V → V → JoinResult V) (x y : JoinResult V) : Prop :=
  ∀ (S : Type) [Semilattice S] (f : V → S), Sound tryJoin f → denote f x = denote f y

section Laws

variable (tryJoin : V → V → JoinResult V)

theorem join_idem (x : JoinResult V) : Equiv tryJoin (join tryJoin x x) x := by
  intro S _ f hf
  rw [denote_join f hf, sup_idem]

theorem join_comm (x y : JoinResult V) :
    Equiv tryJoin (join tryJoin x y) (join tryJoin y x) := by
  intro S _ f hf
  rw [denote_join f hf, denote_join f hf, sup_comm]

theorem join_assoc (x y z : JoinResult V) :
    Equiv tryJoin (join tryJoin (join tryJoin x y) z) (join tryJoin x (join tryJoin y z)) := by
  intro S _ f hf
  simp only [denote_join f hf, sup_assoc]

theorem join_congr {x x' y y' : JoinResult V} (hx : Equiv tryJoin x x')
    (hy : Equiv tryJoin y y') : Equiv tryJoin (join tryJoin x y) (join tryJoin x' y') := by
  intro S _ f hf
  rw [denote_join f hf, denote_join f hf, hx S f hf, hy S f hf]

omit [DecidableEq V] in
/-- A join that normalises (`try_join a a = Ok n` with `n` structurally different from `a`,
as sorting tap leaf hashes does) is still idempotent modulo `Equiv`. -/
theorem self_join_equiv {a n : V} (h : tryJoin a a = .ok n) : Equiv tryJoin (ok a) (ok n) := by
  intro S _ f hf
  simp only [denote, hf.ok h, sup_idem]

end Laws

section Option

/-- As in `JoinResult.lean`: `absent` sits below two concrete values. -/
inductive Field where
  | absent
  | x
  | y
  deriving DecidableEq

def optionJoin : Field → Field → JoinResult Field
  | .absent, b => ok b
  | a, .absent => ok a
  | a, b => if a = b then ok a else err [a, b]

/-- The two gossip orders of the TLA+ counterexample end in structurally different states. -/
theorem option_regroup :
    join optionJoin (join optionJoin (ok .absent) (ok .x)) (ok .y) = err [.x, .y] ∧
      join optionJoin (ok .absent) (join optionJoin (ok .x) (ok .y)) =
        err [.absent, .x, .y] := by
  constructor <;> rfl

/-- ... which are nevertheless the same element: the replicas did converge. -/
theorem option_converges : Equiv optionJoin (err [.x, .y]) (err [.absent, .x, .y]) := by
  have h := join_assoc optionJoin (ok .absent) (ok .x) (ok .y)
  rwa [option_regroup.1, option_regroup.2] at h

instance : Semilattice (Bool × Bool) where
  sup a b := (a.1 || b.1, a.2 || b.2)
  bot := (false, false)
  sup_idem a := by cases a; simp
  sup_comm a b := by cases a; cases b; simp [Bool.or_comm]
  sup_assoc a b c := by cases a; cases b; cases c; simp [Bool.or_assoc]
  bot_sup a := by cases a; simp

/-- Which of `x`, `y` a state has seen. -/
def optionModel : Field → Bool × Bool
  | .absent => (false, false)
  | .x => (true, false)
  | .y => (false, true)

theorem optionModel_sound : Sound optionJoin optionModel where
  ok {a b c} h := by
    cases a <;> cases b <;> simp [optionJoin] at h <;> subst h <;> rfl
  err {a b l} h := by
    cases a <;> cases b <;> simp [optionJoin] at h <;> subst h <;> rfl

/-- `Equiv` is not trivial: a conflict between `x` and `y` is not `x`. -/
theorem option_nontrivial : ¬ Equiv optionJoin (err [.x, .y]) (ok .x) := by
  intro h
  have := h (Bool × Bool) optionModel optionModel_sound
  exact absurd this (by decide)

end Option

section Flat

/-- A flat `try_join`: the `Foo` impl from the `partial.rs` tests. -/
def flat (a b : V) : JoinResult V := if a = b then ok a else err [a, b]

instance : Semilattice (V → Bool) where
  sup s t v := s v || t v
  bot _ := false
  sup_idem s := funext fun v => by simp
  sup_comm s t := funext fun v => Bool.or_comm ..
  sup_assoc s t u := funext fun v => Bool.or_assoc ..
  bot_sup s := funext fun v => by simp

omit [DecidableEq V] in
@[simp] theorem fn_sup (s t : V → Bool) (v : V) : sup s t v = (s v || t v) := rfl
omit [DecidableEq V] in
@[simp] theorem fn_bot (v : V) : (bot : V → Bool) v = false := rfl

/-- Membership, as `Conflict`'s set semantics sees it. -/
def mem (v : V) : JoinResult V → Bool
  | ok a => decide (v = a)
  | err l => l.contains v

def single (a : V) : V → Bool := fun v => decide (v = a)

theorem denote_single (x : JoinResult V) : denote single x = fun v => mem v x := by
  funext v
  cases x with
  | ok a => rfl
  | err l =>
    simp only [denote, mem]
    induction l with
    | nil => simp [denoteList]
    | cons w l ih => simp [denoteList, ih, single]

theorem single_sound : Sound (flat (V := V)) single where
  ok {a b c} h := by
    unfold flat at h
    by_cases hab : a = b
    · subst hab
      simp at h
      subst h
      funext v
      simp
    · simp [hab] at h
  err {a b l} h := by
    unfold flat at h
    by_cases hab : a = b
    · simp [hab] at h
    · simp [hab] at h
      subst h
      funext v
      simp [denoteList]

/-- For a flat `try_join`, `Equiv` only identifies results with the same members. -/
theorem flat_equiv_members {x y : JoinResult V} (h : Equiv flat x y) :
    ∀ v, mem v x = mem v y := by
  have := h (V → Bool) single single_sound
  rw [denote_single, denote_single] at this
  exact fun v => congrFun this v

end Flat

end ConcurrentPsbt.Modulo
