import Aeneas
import ConcurrentPsbt
import JoinResult

/-!
# Proofs about the Aeneas extraction of `partial.rs`

`ConcurrentPsbt.lean` is generated by Charon and Aeneas from the crate's own sources, so the
functions below are the crate's code, not a transcription. The Rust `Vec` is the `Vec` of
Aeneas' standard library model, `V: PartialJoin` is the record `PartialJoin V`, and every
function returns `Result`, which also carries panics and arithmetic failure.

* `join_mut_spec`: `Conflict::join_mut` is a set union that keeps the first operand's order,
  adds no duplicates to a duplicate-free `Conflict`, and cannot fail unless the `Vec` would
  outgrow `usize`.
* `join_refines`: `impl Join for JoinResult<V>` agrees, arm for arm, with the model `join` of
  `JoinResult.lean`, for every `try_join` that the model describes. So everything proved
  about the model holds for the crate's code: `join_comm_of_flat` and friends.
-/

open Aeneas Aeneas.Std Result
open concurrent_psbt concurrent_psbt.lattice

namespace Proofs

variable {V : Type}

/-- The `PartialEq` of `V` that `Conflict` deduplicates with agrees with `=`, and never fails. -/
def EqSpec (inst : core.cmp.PartialEq V V) : Prop :=
  ∀ a b, inst.eq a b ⦃ r => r = true ↔ a = b ⦄

theorem contains_spec {inst : core.cmp.PartialEq V V} (h : EqSpec inst) (s : Slice V) (x : V) :
    core.slice.Slice.contains inst s x ⦃ b => b = true ↔ x ∈ s.val ⦄ := by
  unfold core.slice.Slice.contains
  generalize s.val = l
  induction l with
  | nil => exact (WP.spec_ok _).2 (by simp)
  | cons a l ih =>
    simp only [List.anyM]
    apply WP.spec_bind (h x a)
    intro r hr
    cases r
    · have hne : x ≠ a := fun h' => by simpa using hr.2 h'
      simpa [List.mem_cons, hne] using ih
    · have hxa : x = a := hr.1 rfl
      exact (WP.spec_ok _).2 (by simp [hxa])

theorem next_spec (it : alloc.vec.into_iter.IntoIter V) :
    alloc.vec.into_iter.IteratorIntoIter.next it ⦃ r =>
      (it.val = [] ∧ r.1 = none) ∨ ∃ hd tl, it.val = hd :: tl ∧ r.1 = some hd ∧ r.2.val = tl ⦄ := by
  unfold alloc.vec.into_iter.IteratorIntoIter.next
  split <;> simp_all [WP.spec_ok]

theorem singleton_spec (inst : lattice.partial.PartialJoin V) (v : V) :
    lattice.partial.Conflict.singleton inst v ⦃ c => c.val = [v] ⦄ := by
  unfold lattice.partial.Conflict.singleton
  simp [lift, WP.spec_ok, alloc.slice.Slice.into_vec, Std.Array.to_slice, Std.Array.make]
  rfl

section JoinMut

open lattice.partial.Conflict.Insts in
theorem join_mut_loop_spec {inst : lattice.partial.PartialJoin V}
    (hEq : EqSpec inst.corecmpPartialEqInst)
    (cur0 : lattice.partial.Conflict V) (it0 : alloc.vec.into_iter.IntoIter V)
    (hcap : cur0.val.length + it0.val.length ≤ Usize.max) :
    Concurrent_psbtLatticeJoinJoinMut.join_mut_loop inst it0 cur0 ⦃ r =>
      (∀ x, x ∈ r.val ↔ x ∈ cur0.val ∨ x ∈ it0.val) ∧
      (cur0.val.Nodup → r.val.Nodup) ∧
      cur0.val <+: r.val ∧
      r.val.length ≤ cur0.val.length + it0.val.length ⦄ := by
  unfold Concurrent_psbtLatticeJoinJoinMut.join_mut_loop
  refine loop.spec_decr_nat (fun (p : alloc.vec.into_iter.IntoIter V × lattice.partial.Conflict V) => p.1.val.length)
    (fun (p : alloc.vec.into_iter.IntoIter V × lattice.partial.Conflict V) => ∃ consumed : List V,
      it0.val = consumed ++ p.1.val ∧
      (∀ x, x ∈ p.2.val ↔ x ∈ cur0.val ∨ x ∈ consumed) ∧
      (cur0.val.Nodup → p.2.val.Nodup) ∧
      cur0.val <+: p.2.val ∧
      p.2.val.length ≤ cur0.val.length + consumed.length ∧
      p.2.val.length + p.1.val.length ≤ Usize.max) _ _ _ ?_ ?_
  · rintro ⟨it, self⟩ ⟨consumed, h1, h2, h3, h4, h5, h6⟩
    dsimp only at *
    unfold Concurrent_psbtLatticeJoinJoinMut.join_mut_loop.body
    apply WP.spec_bind (next_spec it)
    rintro ⟨o, it1⟩ hn
    rcases hn with ⟨hnil, rfl⟩ | ⟨hd, tl, hcons, rfl, hit1⟩
    · refine (WP.spec_ok _).2 ?_
      simp only [hnil, List.append_nil] at h1
      subst h1
      exact ⟨h2, h3, h4, h5⟩
    · simp only
      apply WP.spec_bind (contains_spec hEq (alloc.vec.Vec.deref self) hd)
      intro b hb
      have hmem : hd ∈ self.val ↔ b = true := by simpa [alloc.vec.Vec.deref] using hb.symm
      have hlen : (it1.val.length) < it.val.length := by simp [hcons, hit1]
      by_cases hb' : b = true
      · simp only [hb', ite_true, WP.spec_ok]
        refine ⟨⟨consumed ++ [hd], ?_, ?_, h3, h4, ?_, ?_⟩, hlen⟩
        · simp [h1, hcons, hit1]
        · intro x
          have hhd := hmem.2 hb'
          rw [h2 x, List.mem_append, List.mem_singleton]
          constructor
          · rintro (h | h)
            · exact Or.inl h
            · exact Or.inr (Or.inl h)
          · rintro (h | h | h)
            · exact Or.inl h
            · exact Or.inr h
            · rw [h]; exact (h2 hd).1 hhd
        · simp; omega
        · simp [hit1, hcons] at *; omega
      · have hb'' : b = false := by simpa using hb'
        subst hb''
        simp only [Bool.false_eq_true, ite_false]
        apply WP.spec_bind (alloc.vec.Vec.push_spec self hd (by simp [hcons] at h6; omega))
        intro v hv
        simp only [WP.spec_ok]
        have hnm : hd ∉ self.val := by simpa using hmem
        refine ⟨⟨consumed ++ [hd], ?_, ?_, ?_, ?_, ?_, ?_⟩, hlen⟩
        · simp [h1, hcons, hit1]
        · intro x
          simp only [hv, List.mem_append, List.mem_singleton, h2 x]
          tauto
        · intro hn
          rw [hv]
          have h3' := h3 hn
          simp [List.nodup_append, h3']
          first | done | (intro a ha h; subst h; exact hnm ha)
        · rw [hv]; exact h4.trans (List.prefix_append _ _)
        · rw [hv]; simp; omega
        · rw [hv]; simp [hit1, hcons] at *; omega
  · exact ⟨[], by simp, by simp, id, List.prefix_refl _, by simp, hcap⟩

open lattice.partial.Conflict.Insts in
theorem join_mut_spec {inst : lattice.partial.PartialJoin V}
    (hEq : EqSpec inst.corecmpPartialEqInst)
    (self other : lattice.partial.Conflict V)
    (hcap : self.val.length + other.val.length ≤ Usize.max) :
    Concurrent_psbtLatticeJoinJoinMut.join_mut inst self other ⦃ r =>
      (∀ x, x ∈ r.val ↔ x ∈ self.val ∨ x ∈ other.val) ∧
      (self.val.Nodup → r.val.Nodup) ∧
      self.val <+: r.val ∧
      r.val.length ≤ self.val.length + other.val.length ⦄ := by
  unfold Concurrent_psbtLatticeJoinJoinMut.join_mut
  apply WP.spec_bind ((WP.spec_ok (p := fun r => r = other) other).2 rfl)
  intro iter hiter
  rw [hiter]
  exact join_mut_loop_spec hEq self other hcap

end JoinMut

section Join

variable [DecidableEq V]

/-- A `Conflict` compared as a set, as `Conflict`'s `PartialEq` does and `JoinResult.lean`
models it. -/
def abs : core.result.Result V (lattice.partial.Conflict V) → ConcurrentPsbt.JoinResult V
  | .Ok v => .ok v
  | .Err c => .err fun v => decide (v ∈ c.val)

/-- Number of values a `JoinResult` holds; what `Vec::push` has to fit into a `usize`. -/
def size : core.result.Result V (lattice.partial.Conflict V) → Nat
  | .Ok _ => 1
  | .Err c => c.val.length

def IsOk : core.result.Result V (lattice.partial.Conflict V) → Prop
  | .Ok _ => True
  | .Err _ => False

/-- `impl Join for JoinResult<V>` of `partial.rs`. -/
abbrev join (inst : lattice.partial.PartialJoin V) :=
  core.result.ResultVConflict.Insts.Concurrent_psbtLatticeJoinJoin.join inst

/-- The crate's `join` on `JoinResult<V>` is the model `join` of `JoinResult.lean`, with
conflicts read as sets, whenever the values fit in a `Vec`; and joining anything with a
conflict yields a conflict that is no larger than its operands together. -/
theorem join_refines {inst : lattice.partial.PartialJoin V}
    (hEq : EqSpec inst.corecmpPartialEqInst)
    (tj : V → V → ConcurrentPsbt.JoinResult V)
    (hTry : ∀ a b, inst.try_join a b ⦃ r => abs r = tj a b ⦄)
    (x y : core.result.Result V (lattice.partial.Conflict V))
    (hcap : size x + size y ≤ Usize.max) :
    join inst x y ⦃ r =>
      abs r = ConcurrentPsbt.join tj (abs x) (abs y) ∧
      (¬ (IsOk x ∧ IsOk y) → size r ≤ size x + size y) ⦄ := by
  unfold join core.result.ResultVConflict.Insts.Concurrent_psbtLatticeJoinJoin.join
  cases x with
  | Ok a =>
    cases y with
    | Ok b =>
      dsimp only
      apply WP.spec_mono (hTry a b)
      intro r hr
      exact ⟨hr, by simp [IsOk]⟩
    | Err b =>
      dsimp only
      apply WP.spec_bind (singleton_spec inst a)
      intro c hc
      simp only [lattice.join.Join.Blanket.join]
      apply WP.spec_bind (join_mut_spec hEq c b (by simp [hc, size] at hcap ⊢; omega))
      rintro r ⟨hmem, -, -, hlen⟩
      refine (WP.spec_ok _).2 ⟨?_, ?_⟩
      · simp only [abs, ConcurrentPsbt.join]
        congr 1
        funext v
        simp [ConcurrentPsbt.Conflict.union, ConcurrentPsbt.Conflict.singleton, hmem, hc]
      · intro _
        simp [size, hc] at hlen ⊢
        omega
  | Err a =>
    cases y with
    | Ok b =>
      dsimp only
      apply WP.spec_bind (singleton_spec inst b)
      intro c hc
      simp only [lattice.join.Join.Blanket.join]
      apply WP.spec_bind (join_mut_spec hEq a c (by simp [hc, size] at hcap ⊢; omega))
      rintro r ⟨hmem, -, -, hlen⟩
      refine (WP.spec_ok _).2 ⟨?_, ?_⟩
      · simp only [abs, ConcurrentPsbt.join]
        congr 1
        funext v
        simp [ConcurrentPsbt.Conflict.union, ConcurrentPsbt.Conflict.singleton, hmem, hc]
      · intro _
        simp [size, hc] at hlen ⊢
        omega
    | Err b =>
      dsimp only
      simp only [lattice.join.Join.Blanket.join]
      apply WP.spec_bind (join_mut_spec hEq a b (by simpa [size] using hcap))
      rintro r ⟨hmem, -, -, hlen⟩
      refine (WP.spec_ok _).2 ⟨?_, ?_⟩
      · simp only [abs, ConcurrentPsbt.join]
        congr 1
        funext v
        simp [ConcurrentPsbt.Conflict.union, hmem]
      · intro _
        simpa [size] using hlen

/-- With a flat `try_join` (`Ok` exactly on equal values, as in the tests of `partial.rs`)
the crate's `join` is idempotent, up to the set equality `Conflict` implements. -/
theorem join_idem_of_flat {inst : lattice.partial.PartialJoin V}
    (hEq : EqSpec inst.corecmpPartialEqInst)
    (hFlat : ∀ a b, inst.try_join a b ⦃ r => abs r = ConcurrentPsbt.flat a b ⦄)
    (x : core.result.Result V (lattice.partial.Conflict V))
    (hcap : size x + size x ≤ Usize.max) :
    join inst x x ⦃ r => abs r = abs x ⦄ := by
  apply WP.spec_mono (join_refines hEq _ hFlat x x hcap)
  rintro r ⟨hr, -⟩
  rw [hr]
  exact ConcurrentPsbt.flat_idem _

theorem spec_ok_eq {α : Type _} {m : Result α} {p : α → Prop} (h : m ⦃ p ⦄) :
    ∃ v, m = ok v ∧ p v := by
  refine Result.cases (motive := fun m => m ⦃ p ⦄ → ∃ v, m = ok v ∧ p v) m ?_ ?_ ?_ h
  · intro r hr
    exact ⟨r, rfl, (WP.spec_ok r).1 hr⟩
  · intro i k hk
    exact absurd hk (by simp [WP.spec_vis])
  · intro hk
    exact absurd hk (by simp [WP.spec_div])

/-- With a flat `try_join`, the crate's `join` is commutative, up to set equality. -/
theorem join_comm_of_flat {inst : lattice.partial.PartialJoin V}
    (hEq : EqSpec inst.corecmpPartialEqInst)
    (hFlat : ∀ a b, inst.try_join a b ⦃ r => abs r = ConcurrentPsbt.flat a b ⦄)
    (x y : core.result.Result V (lattice.partial.Conflict V))
    (hcap : size x + size y ≤ Usize.max) :
    ∃ r r', join inst x y = ok r ∧ join inst y x = ok r' ∧ abs r = abs r' := by
  obtain ⟨r, hr, hrabs, -⟩ := spec_ok_eq (join_refines hEq _ hFlat x y hcap)
  obtain ⟨r', hr', hrabs', -⟩ := spec_ok_eq (join_refines hEq _ hFlat y x (by omega))
  refine ⟨r, r', hr, hr', ?_⟩
  rw [hrabs, hrabs']
  exact ConcurrentPsbt.flat_comm _ _

theorem usize_max_ge : 3 ≤ Usize.max := by
  have h32 := U32.max_eq
  have h64 := U64.max_eq
  rcases Usize.bounds_eq with h | h <;> omega

/-- If the crate's `join` is associative, up to set equality of conflicts, wherever it is
defined, then `try_join` can only return `Ok` for equal values. So a `PartialJoin` with a
non-trivial least upper bound, which the docs of `try_join` allow, breaks the `Join` laws of
`JoinResult` under the structural equality the crate uses; `Modulo.lean` in `formal/lean`
shows they hold modulo the congruence `try_join` generates. The witness is
`(Ok a ⊔ Ok b) ⊔ Err{c}` against `Ok a ⊔ (Ok b ⊔ Err{c})`. -/
theorem join_assoc_forces_flat {inst : lattice.partial.PartialJoin V}
    (hEq : EqSpec inst.corecmpPartialEqInst)
    (tj : V → V → ConcurrentPsbt.JoinResult V)
    (hTry : ∀ a b, inst.try_join a b ⦃ r => abs r = tj a b ⦄)
    (hAssoc : ∀ x y z xy yz l r, join inst x y = ok xy → join inst xy z = ok l →
      join inst y z = ok yz → join inst x yz = ok r → abs l = abs r)
    {a b c : V} (h : tj a b = ConcurrentPsbt.JoinResult.ok c) : a = b := by
  have hmax := usize_max_ge
  obtain ⟨cc, hccEq, hcc⟩ := spec_ok_eq (singleton_spec inst c)
  obtain ⟨xy, hxy, hxyabs, -⟩ := spec_ok_eq
    (join_refines hEq tj hTry (.Ok a) (.Ok b) (by simp [size]; omega))
  have hxyOk : xy = core.result.Result.Ok c := by
    cases xy with
    | Ok v =>
      simp [abs, ConcurrentPsbt.join, h] at hxyabs
      rw [hxyabs]
    | Err v => simp [abs, ConcurrentPsbt.join, h] at hxyabs
  subst hxyOk
  obtain ⟨l, hl, hlabs, -⟩ := spec_ok_eq
    (join_refines hEq tj hTry (.Ok c) (.Err cc) (by simp [size, hcc]; omega))
  obtain ⟨yz, hyz, hyzabs, hyzsize⟩ := spec_ok_eq
    (join_refines hEq tj hTry (.Ok b) (.Err cc) (by simp [size, hcc]; omega))
  have hyzs := hyzsize (by simp [IsOk])
  have hyz2 : size yz ≤ 2 := by simpa [size, hcc] using hyzs
  have h1 : size (core.result.Result.Ok a : core.result.Result V (lattice.partial.Conflict V))
      = 1 := rfl
  obtain ⟨r, hr, hrabs, -⟩ := spec_ok_eq
    (join_refines hEq tj hTry (.Ok a) yz (by omega))
  have e := hAssoc (.Ok a) (.Ok b) (.Err cc) _ yz l r hxy hl hyz hr
  rw [hlabs, hrabs, hyzabs] at e
  simp only [abs, ConcurrentPsbt.join] at e
  injection e with e
  have ea := congrFun e a
  have eb := congrFun e b
  simp [ConcurrentPsbt.Conflict.union, ConcurrentPsbt.Conflict.singleton, hcc] at ea eb
  rw [ea, eb]

end Join

end Proofs
